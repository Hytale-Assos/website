# Non-secret runtime configuration for hytale-website.
# Copy on the deployment host to /home/hytale/hytale/env/website.env
# (the path referenced by hytale-website.container) and fill in the
# values.
#
# Sensitive values are podman secrets and never live in this file:
#   APP_KEY, DB_PASSWORD, HYTALE_API_KEY, HYTALE_API_HMAC_SECRET,
#   DISCORD_CLIENT_SECRET, MAIL_PASSWORD, PASSKEYS_USER_HANDLE_SECRET.
# See the provisioning commands in hytale-website.container.

APP_NAME="Hytale Assos"
APP_ENV=production
APP_URL=https://example.org

# TLS-terminating reverse proxy (Traefik) in front of the container. Laravel
# must trust its X-Forwarded-* headers or it generates http:// URLs while the
# browser is on https:// (which hides the X-Inertia response header), and it
# cannot recover the real client IP from X-Forwarded-For.
#
# Trust only the proxy's network, never "*": "*" trusts the left-most
# X-Forwarded-For entry, which a public client can spoof. Set this to the CIDR
# of the network shared with Traefik. Here the container is on 10.89.3.0/24
# (Traefik at 10.89.3.3).
TRUSTED_PROXIES=10.89.3.0/24

# Comma-separated list of IP addresses (or CIDR ranges) allowed to scrape the
# /prometheus metrics endpoint. Empty = all IPs allowed, which is WRONG here:
# fill it with the scraper's IP before going live.
PROMETHEUS_ALLOWED_IPS=

# Do NOT set CADDY_GLOBAL_OPTIONS here. The default Caddyfile interpolates it
# inline (`{$CADDY_GLOBAL_OPTIONS}` inside a global options block), so any
# `servers { ... }` value must span several lines to be valid. A podman
# --env-file cannot hold a newline, so Caddy fails to adapt its config and the
# container never starts (Traefik then returns 502). It is not needed anyway:
# FrankenPHP passes the incoming X-Forwarded-For straight through and Laravel
# already trusts it via TRUSTED_PROXIES. Only Caddy's own `{client_ip}`
# placeholder (access logs, client_ip matcher) would use it, and nothing here
# relies on those.

# Registration gate. Comma-separated school email domains; registering
# with a matching domain creates an internal account, everything else
# requires an invitation. Empty = invitations only — and with no
# internal member able to register, nobody can ever send one: fill
# this before the first boot.
SCHOOL_EMAIL_DOMAINS=
# An internal member holds at most this many active invitations
# (accepted + pending).
MEMBERS_INVITATION_LIMIT=5

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=hytale-postgres
DB_PORT=5432
DB_DATABASE=hytale
DB_USERNAME=hytale

SESSION_DRIVER=database
# Encrypted session payloads: keeps password hashes and auth state out of
# database dumps. Rotating APP_KEY or enabling this on an existing install
# invalidates all sessions: truncate the sessions table when deploying.
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=hytale-redis
REDIS_PORT=6379

# Hytale core API. HYTALE_API_MOCK=true keeps the in-memory mock
# while the core is not deployed; point HYTALE_API_URL at it when
# it is.
HYTALE_API_URL=http://localhost:3000
HYTALE_API_MOCK=true
HYTALE_MODULE_ID=01a0a967-cb40-76c1-a30a-4983d3633605
HYTALE_MODULE_NAME=siteweb

# Discord OAuth (linked accounts). DISCORD_CLIENT_SECRET is a podman
# secret. The redirect URI is a path resolved against APP_URL at runtime:
# systemd does not expand ${APP_URL}, so the literal would be sent to
# Discord and rejected. Register the matching callback URL with the
# Discord application: <APP_URL>/auth/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=/auth/discord/callback

# Mail (MAIL_PASSWORD is a podman secret). smtp by default: a broken
# relay fails loudly instead of silently swallowing the verification
# and password-reset emails, and no member page is reachable without
# a verified email. Values target the OVH MX Plan relay (STARTTLS on
# 587); MAIL_USERNAME is the sending mailbox address (OVH SMTP
# authenticates with the full mailbox address). Only MAIL_PASSWORD is
# provisioned on the host, as a podman secret. log is a dev-only
# fallback.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=587
MAIL_USERNAME="no-reply.hytale@atj.ovh"
MAIL_FROM_ADDRESS="no-reply.hytale@atj.ovh"
MAIL_FROM_NAME="Hytale Assos"
