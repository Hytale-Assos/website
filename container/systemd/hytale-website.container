# Hytale website (Laravel + FrankenPHP), unprivileged image.
# The generated systemd unit is hytale-website.service.
#
# The image runs as appuser (uid 1000) and listens on :8080
# (SERVER_NAME default). Application configuration comes from the
# environment file below: APP_KEY, APP_URL, DB_HOST=hytale-postgres,
# DB_DATABASE, DB_USERNAME, DB_PASSWORD, REDIS_HOST=hytale-redis,
# HYTALE_API_URL, HYTALE_API_KEY, HYTALE_API_HMAC_SECRET, MAIL_*.
# Create it on the deployment host and adjust the path if you
# run rootless.
#
# Hardening: NoNewPrivileges + DropCapability=ALL (the image is
# already non-root, port > 1024, no file capabilities) and a
# read-only root filesystem. Tmpfs mounts give back the writable
# paths: /tmp (PHP uploads), /app/storage (compiled views, cache),
# /app/bootstrap/cache (framework manifests, regenerated when
# absent), /data/caddy and /config/caddy (Caddy autosave).
# Nothing writable survives a restart, nothing persists outside
# PostgreSQL.
#
# Run migrations after pulling a new image:
#   podman run --rm --network hytale-website-hytale-postgres \
#     --env-file /etc/hytale/website.env \
#     ghcr.io/hytale-assos/website:latest php artisan migrate --force

[Unit]
Description=Hytale website (Laravel + FrankenPHP)
Requires=hytale-postgres.service hytale-redis.service
After=hytale-postgres.service hytale-redis.service

[Container]
Image=ghcr.io/hytale-assos/website:latest
ContainerName=hytale-website
Network=hytale-website-hytale-postgres.network
Network=hytale-website-hytale-redis.network
PublishPort=80:8080
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,uid=1000,gid=1000,mode=1777
Tmpfs=/app/storage:rw,uid=1000,gid=1000
Tmpfs=/app/bootstrap/cache:rw,uid=1000,gid=1000
Tmpfs=/data/caddy:rw,uid=1000,gid=1000
Tmpfs=/config/caddy:rw,uid=1000,gid=1000
EnvironmentFile=/etc/hytale/website.env
HealthCmd=curl -fsS http://127.0.0.1:8080/up
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s
# podman-auto-update.service can roll this container forward:
AutoUpdate=registry

[Service]
Restart=always
RestartSec=3s

[Install]
WantedBy=default.target
