APP_NAME="Hytale Assos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Dedicated secret for WebAuthn passkey user handles. Required in
# production (the app refuses to boot without it): without it Fortify
# falls back to APP_KEY, coupling passkeys to the encryption key.
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
PASSKEYS_USER_HANDLE_SECRET=

# Registration gate. Comma-separated school email domains; registering
# with a matching domain creates an internal account without an
# invitation, everything else requires one. Empty = invitations only.
SCHOOL_EMAIL_DOMAINS=
# An internal member holds at most this many active invitations
# (accepted + pending).
MEMBERS_INVITATION_LIMIT=5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Server-side rendering is disabled: the production image ships without an
# SSR node server (see container/Containerfile), so dev matches production.
INERTIA_SSR_ENABLED=false

# Reverse proxy that terminates TLS in front of the app. Laravel must trust its
# X-Forwarded-* headers or it generates http:// URLs behind an https page and
# cannot recover the real client IP. Set this to the network shared with the
# proxy (never "*", which trusts a client-spoofable X-Forwarded-For entry).
# Leave empty to trust none, which is right for local development.
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypted session payloads: keeps password hashes and auth state out of
# database dumps. Rotating APP_KEY or enabling this on an existing install
# invalidates all sessions: truncate the sessions table when deploying.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Hytale core API (docs/api.md). The website is the `siteweb` module.
# Inside Sail, use host.docker.internal to reach the core running on the host.
HYTALE_API_URL=http://host.docker.internal:3000
HYTALE_API_KEY=
HYTALE_API_HMAC_SECRET=
HYTALE_API_TOLERANCE=300
HYTALE_API_TIMEOUT=10
# Use the in-memory mock while the core is not deployed.
HYTALE_API_MOCK=true
HYTALE_MODULE_ID=01a0a967-cb40-76c1-a30a-4983d3633605
HYTALE_MODULE_NAME=siteweb
HYTALE_API_CACHE=true
HYTALE_API_CACHE_STORE=redis
HYTALE_API_CACHE_TTL=60

# Discord OAuth (linked accounts). The redirect URI is a path resolved
# against APP_URL at runtime; leave it as-is so it follows the configured
# domain without hardcoding it.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=/auth/discord/callback

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
